# S-17. Все переменные окружения проекта. Настоящих паролей и ключей здесь нет: они живут только в .env
# (он в .gitignore) на машине разработчика и на сервере.
# Локально: скопируй в .env, если нужны свои значения (по умолчанию всё работает и без .env).
# На сервере: скопируй в ~/m094diploma/.env (prod) или ~/m094diploma-staging/.env (staging), замени значения
# с пометкой «сервер», chmod 600 — см. docs/server.md, раздел «Секреты».

## База — docker-compose.yml и deploy/compose.yml
POSTGRES_USER=m094
# Сервер: свой длинный случайный пароль, только [0-9a-f] (он подставляется в DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=m094
POSTGRES_DB=m094

## Порты на 127.0.0.1 — только локально (docker-compose.yml). На сервере наружу ничего не публикуется.
DB_PORT=5433
APP_PORT=8080
MOCK_PORT=4010

## Приложение — internal/config. На сервере app получает весь .env через env_file (deploy/compose.yml).
# Локально эти строки ничего не меняют: app в docker-compose.yml получает только ADDR и DATABASE_URL,
# а make run читает переменные shell, не .env.
# DATABASE_URL задавать не нужно: на сервере его собирает deploy/compose.yml из POSTGRES_*,
# локально — docker-compose.yml и Makefile. Формат: postgres://USER:PASSWORD@HOST:5432/DB?sslmode=disable
# ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
# Сервер: обязательно true — перед app стоит Caddy (docs/server.md, S-12). Без прокси — false.
TRUST_PROXY=true
SHUTDOWN_TIMEOUT=10s
# Ключи ИИ-провайдеров появятся здесь вместе с их чтением в internal/config. Кладутся только в .env.

## Выкатка — deploy/compose.yml (S-13)
# Тег образа ghcr.io/darkil1ght/m094diploma для ручного запуска compose: main — staging, latest — prod.
# CI при выкатке передаёт точный тег (sha-<коммит> или vX.Y.Z) сам, поверх этого значения.
IMAGE_TAG=main
# Сервер: внешняя docker-сеть общего Caddy (docker network ls).
CADDY_NETWORK=caddy
# Имя app в сети Caddy (APP_ALIAS) не задаётся: deploy/deploy.sh выводит его из каталога окружения —
# m094diploma-app (prod), m094diploma-staging-app (staging).
